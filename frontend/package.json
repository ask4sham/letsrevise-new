{
  "name": "letsrivise-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18 <23",
    "npm": ">=9"
  },
  "description": "Frontend for LetsRivise — local dev defaults to port 3000. Port 3001 is reserved for LetsRevise Lesson Generator (separate repo).",
  "author": "LetsRivise Team",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@sentry/browser": "^10.43.0",
    "@sentry/core": "^10.43.0",
    "@supabase/supabase-js": "^2.87.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.0",
    "react-scripts": "5.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/dev-server-start.js",
    "start:cra": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write .",
    "fix:edit-lesson-jsx": "node scripts/fix-edit-lesson-jsx.js",
    "render:mitosis-pngs": "node scripts/render-mitosis-pngs.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/src/__mocks__/react-router-dom.js"
    }
  },
  "proxy": "http://localhost:5000",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.25",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/letsrivise-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/letsrivise-frontend/issues"
  }
}
