# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-study-assistant?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Frontend: API host for requests and asset URLs (set in frontend .env)
# Must be the backend origin with NO /api — assets like /uploads/ai-diagrams/... are served at host root.
# REACT_APP_API_HOST=http://localhost:5000

# Email Configuration (for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Pricing (amounts in pence; optional — defaults in backend/config/pricing.js)
# SUBSCRIPTION_MONTHLY_PRICE_PENCE=999
# SUBSCRIPTION_ANNUAL_PRICE_PENCE=8999

# Stripe Configuration (for production payments)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin Configuration
ADMIN_EMAIL=admin@aistudyassistant.com
ADMIN_PASSWORD=ChangeThisPassword123!

# App Configuration
APP_NAME=AI Study Assistant
APP_URL=http://localhost:5000

# OpenAI (reteach plans, lesson factory, DALL·E 3 diagrams, etc.)
# Set OPENAI_API_KEY to your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# Optional: model id for lesson generation (see backend/routes/ai.js).
# OPENAI_MODEL=gpt-4o-mini
# Optional: sampling temperature 0–2 for slightly more varied lesson phrasing (Responses API). Omit if unset; invalid values are ignored.
# OPENAI_TEMPERATURE=0.75
# Leave DISABLE_OPENAI unset (or set to 0) to enable AI. Set DISABLE_OPENAI=1 only for tests.
# DISABLE_OPENAI=0

# Diagram alignment (optional): backend URL for vision check + retry. If unset, derived from request.
# BASE_URL=http://localhost:5000

# Uploads (optional; defaults used by diagram generation if unset)
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=5242880

# Supabase Storage — persistent storage for lesson media (preferred when you have Supabase)
# When set, uploads go to Supabase Storage and return public URLs
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_MEDIA_BUCKET=lesson-media

# Cloudflare R2 — alternative persistent storage (when Supabase not used)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=letsrevise-media
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# When true, image/video uploads must succeed via Supabase Storage or R2 — no local disk fallback (use in production once cloud is configured).
# REQUIRE_CLOUD_UPLOADS=true

# Sentry error monitoring (optional; leave unset to disable)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Frontend: add REACT_APP_SENTRY_DSN in Netlify env for frontend errors

# PR-HARD-2: Input limits, upload, rate limiting
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_BULK=30
# RATE_LIMIT_MAX_UPLOAD=20
# RATE_LIMIT_MAX_ATTEMPT=60
# BULK_BODY_LIMIT_BYTES=2097152
# BULK_MAX_TEXT_LENGTH=2097152
# MAX_FILES_PER_REQUEST=10
# FILE_UPLOAD_MAX_MB=25