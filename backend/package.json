{
  "name": "letsrivise-backend",
  "version": "1.0.0",
  "description": "Backend API for LetsRivise - UK Learning Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:cell-structure": "node scripts/seed_cell_structure_questions.js",
    "seed:aqa-bio-cell-structure": "node scripts/seed_aqa_gcse_biology_cell_structure.js",
    "seed:aqa-bio-eukaryotes-prokaryotes": "node scripts/seed_aqa_gcse_biology_eukaryotes_prokaryotes.js",
    "seed:bio:cell-biology": "node scripts/aqa_gcse_biology/seed_unit_cell_biology.js",
    "seed:bio:organisation": "node scripts/aqa_gcse_biology/seed_unit_organisation.js",
    "seed:bio:infection-and-response": "node scripts/aqa_gcse_biology/seed_unit_infection_and_response.js",
    "seed:bio:bioenergetics": "node scripts/aqa_gcse_biology/seed_unit_bioenergetics.js",
    "seed:bio:homeostasis-and-response": "node scripts/aqa_gcse_biology/seed_unit_homeostasis_and_response.js",
    "seed:bio:inheritance-variation-evolution": "node scripts/aqa_gcse_biology/seed_unit_inheritance_variation_evolution.js",
    "seed:bio:ecology": "node scripts/aqa_gcse_biology/seed_unit_ecology.js",
    "seed:bio:cell-biology:cell-structure": "node scripts/aqa_gcse_biology/seed_cell-biology__cell-structure.js",
    "seed:bio:cell-biology:batch-a": "node scripts/aqa_gcse_biology/seed_batch_cell_biology_A.js",
    "seed:bio:cell-biology:batch-b": "node scripts/aqa_gcse_biology/seed_batch_cell_biology_B.js",
    "seed:bio:cell-biology:batch-c": "node scripts/aqa_gcse_biology/seed_batch_cell_biology_C.js",
    "seed:bio:all": "node scripts/aqa_gcse_biology/seed_all.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:assessment": "jest tests/assessmentAttempts.integration.test.js",
    "test:assessment:watch": "jest --watch tests/assessmentAttempts.integration.test.js",
    "migrate:all": "node scripts/migrations/backfill_topic_quiz_kind.js && node scripts/migrations/backfill_topic_flashcard_fingerprint.js",
    "verify:indexes": "node scripts/verify-indexes.js",
    "sync:indexes": "node scripts/sync-indexes.js",
    "validate:taxonomies": "node scripts/validateTaxonomies.js",
    "export:taxonomy-topics": "node scripts/exportTaxonomyTopicList.js",
    "create:content-sprint-tracker": "node scripts/createContentSprintTracker.js",
    "diagnose:lesson-flashcards": "node scripts/diagnoseLessonFlashcards.js",
    "audit:question-banks-biology": "node scripts/questionBankAuditBiologyGcse.js",
    "audit:question-banks:spec": "node scripts/auditQuestionBanks.js --spec",
    "audit:question-banks:all": "node scripts/auditQuestionBanks.js --all",
    "convert:exam-csv": "node scripts/convertExamQuestionsCsvToJson.js",
    "convert:past-papers-csv": "node scripts/convertPastPapersCsvToJson.js",
    "convert:past-paper-questions-csv": "node scripts/convertPastPaperQuestionsCsvToJson.js",
    "maintenance:dedup-practice": "node scripts/runDedupLessonPracticeSources.js",
    "maintenance:dedup-practice:apply": "node scripts/runDedupLessonPracticeSources.js --apply",
    "maintenance:dedup-practice:apply:force": "node scripts/runDedupLessonPracticeSources.js --apply --force",
    "maintenance:dedup-practice:spec": "node scripts/runDedupLessonPracticeSources.js --spec",
    "maintenance:dedup-practice:spec:apply": "node scripts/runDedupLessonPracticeSources.js --apply --spec",
    "maintenance:dedup-practice:spec:apply:force": "node scripts/runDedupLessonPracticeSources.js --apply --force --spec",
    "maintenance:sprint-order": "node scripts/runBuildSprintOrderFromCoverage.js",
    "maintenance:sprint-order:apply": "node scripts/runBuildSprintOrderFromCoverage.js --apply",
    "maintenance:sprint-order:spec": "node scripts/runBuildSprintOrderFromCoverage.js",
    "maintenance:sprint-order:spec:apply": "node scripts/runBuildSprintOrderFromCoverage.js --apply",
    "lint": "eslint .",
    "format": "prettier --write .",
    "vector:up": "docker compose -f ../docker-compose.vector.yml up -d",
    "vector:down": "docker compose -f ../docker-compose.vector.yml down",
    "vector:logs": "docker logs -f letsrevise-vector-db",
    "vector:migrate": "node scripts/runVectorMigrations.js",
    "vector:reset": "docker compose -f ../docker-compose.vector.yml down -v",
    "worker:knowledge-refresh": "node workers/knowledgeRefreshWorker.js",
    "migrate:legacy-image-urls": "node scripts/migrate-legacy-image-urls.js",
    "migrate:legacy-image-urls:apply": "node scripts/migrate-legacy-image-urls.js --apply"
  },
  "keywords": [
    "education",
    "learning-platform",
    "uk-curriculum",
    "elearning"
  ],
  "author": "LetsRivise Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@sentry/node": "^10.43.0",
    "@supabase/supabase-js": "^2.88.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "pg": "^8.19.0",
    "rate-limiter-flexible": "^3.0.0",
    "resend": "^6.6.0",
    "swagger-ui-express": "^5.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/letsrivise-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/letsrivise-backend/issues"
  },
  "homepage": "https://github.com/yourusername/letsrivise-backend#readme",
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/",
      "/coverage/"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!tests/**",
      "!coverage/**",
      "!**/*.test.js",
      "!**/*.spec.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  }
}
